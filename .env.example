CHANNELS_FILE=/home/tommy/crtv/channels.json
LOG_FILE=/home/tommy/crtv/logs/crtv_service.log
MPV_LOG_FILE=/home/tommy/crtv/logs/mpv.log
TV_SOCK=/tmp/crt_player.sock
CONTROL_SOCKET=/tmp/crtv-control.sock
STATIC_FILE=/home/tommy/crtv/assets/static.mp4

# X11 defaults. For composite/DRM-only deployments, these may need to change.
DISPLAY=:0
XAUTHORITY=/home/tommy/.Xauthority

PROFILE=crt-lottes
MPV_VO=gpu
MPV_GPU_CONTEXT=x11egl
MPV_HWDEC=auto
KEEP_ASPECT=no
DOWNSAMPLE_HEIGHT=240
ENABLE_CROP_FILTER=0
CROP_X_PCT=55

INITIAL_VOLUME=10
VOLUME_STEP_PCT=10
INITIAL_BRIGHTNESS_PCT=35
BRIGHTNESS_STEP_PCT=20

TARGET_READY_TIMEOUT_SECONDS=8
ENABLE_RANDOM_START=1
RANDOM_START_MIN_PCT=20
RANDOM_START_MAX_PCT=80

STANDBY_BUTTON_ENABLED=1
STANDBY_BUTTON_PIN=16
STANDBY_BUTTON_HOLD_SECONDS=1.5

ADS1115_ENABLED=1
ADS1115_BUS=1
ADS1115_ADDRESS=0x48
ADS1115_CHANNEL=3
ADS1115_INVERTED=1
ADS1115_ZERO_RAW_THRESHOLD=90
ADS1115_MIN_SPAN=32
ADS1115_LOG_FLOOR_DB=-40
ADS1115_ZERO_THRESHOLD_PCT=3
ADS1115_POLL_SECONDS=0.20
ADS1115_DEADBAND_PCT=2

ALSA_INIT_ENABLED=1
ALSA_MASTER_VOLUME_PCT=100
AUDIO_HIGHPASS_ENABLED=1
AUDIO_HIGHPASS_CUTOFF_HZ=120

PISUGAR_ENABLED=1
PISUGAR_HOST=127.0.0.1
PISUGAR_PORT=8423
PISUGAR_TCP_CMD=nc -q 0
PISUGAR_SOCKET_CMD=nc -U /tmp/pisugar-server.sock
PISUGAR_SOFT_POWEROFF_ENABLED=1
PISUGAR_SOFT_POWEROFF_SHELL=sudo shutdown now
PISUGAR_BUTTON_SINGLE_ENABLED=0
PISUGAR_BUTTON_DOUBLE_ENABLED=0
PISUGAR_BUTTON_LONG_ENABLED=1
PISUGAR_BUTTON_LONG_SHELL=sudo shutdown now
PISUGAR_ANTI_MISTOUCH_ENABLED=1
PISUGAR_SAFE_SHUTDOWN_LEVEL=3
PISUGAR_SAFE_SHUTDOWN_DELAY=30

DISPLAY_OFF_CMD=vcgencmd display_power 0
DISPLAY_ON_CMD=vcgencmd display_power 1
SHUTDOWN_CMD=sudo shutdown now
